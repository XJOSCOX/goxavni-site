generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model BookkeeperUser {
  id                String          @id @db.Uuid
  name              String
  email             String          @unique
  role              Role
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdMembers    Member[]        @relation("MemberCreator")
  createdTimesheets Timesheet[]     @relation("TimesheetCreator")
  approvedTimesheets Timesheet[]    @relation("TimesheetApprover")
  auditLogs          AuditLog[]
  contacts           Contact[]
  createdPayments   MemberPayment[] @relation("PaymentCreator")
  documents          Document[]
  invoices           Invoice[]
  reminders          Reminder[]
  subscriptions      Subscription[]
  transactions      Transaction[]
  usedSignupCodes   UsedSignupCode[]

  @@map("users")
}

model UsedSignupCode {
  codeHash String         @id @map("code_hash")
  role     Role
  usedBy   String         @map("used_by") @db.Uuid
  usedAt   DateTime       @default(now()) @map("used_at") @db.Timestamptz(6)
  user     BookkeeperUser @relation(fields: [usedBy], references: [id])

  @@map("used_signup_codes")
}

model Account {
  id                    BigInt          @id @default(autoincrement())
  code                  String          @unique
  name                  String
  type                  AccountType
  active                Boolean         @default(true)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  paidTransactions      Transaction[]   @relation("PaymentAccount")
  categorizedTransactions Transaction[] @relation("CategoryAccount")
  memberPaymentSources  MemberPayment[] @relation("MemberPaymentSource")
  memberPaymentExpenses MemberPayment[] @relation("MemberPaymentExpense")
  subscriptionSources   Subscription[]  @relation("SubscriptionSource")
  subscriptionExpenses  Subscription[]  @relation("SubscriptionExpense")
  invoiceRevenue        Invoice[]       @relation("InvoiceRevenue")
  invoicePayments       Invoice[]       @relation("InvoicePayment")

  @@map("accounts")
}

model Transaction {
  id                BigInt         @id @default(autoincrement())
  occurredOn        DateTime       @map("occurred_on") @db.Date
  type              TransactionType
  party             String
  description       String
  reference         String?
  paymentAccountId  BigInt         @map("payment_account_id")
  categoryAccountId BigInt         @map("category_account_id")
  amountCents       Int            @map("amount_cents")
  createdBy         String         @map("created_by") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  paymentAccount    Account        @relation("PaymentAccount", fields: [paymentAccountId], references: [id])
  categoryAccount   Account        @relation("CategoryAccount", fields: [categoryAccountId], references: [id])
  creator           BookkeeperUser @relation(fields: [createdBy], references: [id])
  memberPayments    MemberPayment[]
  invoices          Invoice[]

  @@map("transactions")
}

model Member {
  id              BigInt          @id @default(autoincrement())
  userId          String?         @map("user_id") @db.Uuid
  name            String
  email           String?
  title           String?
  hourlyRateCents Int             @default(0) @map("hourly_rate_cents")
  active          Boolean         @default(true)
  createdBy       String?         @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  creator         BookkeeperUser? @relation("MemberCreator", fields: [createdBy], references: [id])
  timesheets      Timesheet[]
  payments        MemberPayment[]

  @@map("members")
}

model Timesheet {
  id              BigInt          @id @default(autoincrement())
  memberId        BigInt          @map("member_id")
  workDate        DateTime        @map("work_date") @db.Date
  hours           Decimal         @db.Decimal(6, 2)
  hourlyRateCents Int             @default(0) @map("hourly_rate_cents")
  project         String?
  notes           String?
  status          TimesheetStatus @default(submitted)
  createdBy       String          @map("created_by") @db.Uuid
  approvedBy      String?         @map("approved_by") @db.Uuid
  approvedAt      DateTime?       @map("approved_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  member          Member          @relation(fields: [memberId], references: [id])
  creator         BookkeeperUser  @relation("TimesheetCreator", fields: [createdBy], references: [id])
  approver        BookkeeperUser? @relation("TimesheetApprover", fields: [approvedBy], references: [id])

  @@map("timesheets")
}

model MemberPayment {
  id                BigInt         @id @default(autoincrement())
  memberId          BigInt         @map("member_id")
  transactionId     BigInt?        @map("transaction_id")
  paidOn            DateTime       @map("paid_on") @db.Date
  amountCents       Int            @map("amount_cents")
  paymentAccountId  BigInt         @map("payment_account_id")
  expenseAccountId  BigInt         @map("expense_account_id")
  periodStart       DateTime?      @map("period_start") @db.Date
  periodEnd         DateTime?      @map("period_end") @db.Date
  reference         String?
  notes             String?
  createdBy         String         @map("created_by") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  member            Member         @relation(fields: [memberId], references: [id])
  transaction       Transaction?   @relation(fields: [transactionId], references: [id])
  paymentAccount    Account        @relation("MemberPaymentSource", fields: [paymentAccountId], references: [id])
  expenseAccount    Account        @relation("MemberPaymentExpense", fields: [expenseAccountId], references: [id])
  creator           BookkeeperUser @relation("PaymentCreator", fields: [createdBy], references: [id])

  @@map("member_payments")
}

model Subscription {
  id               BigInt         @id @default(autoincrement())
  vendor           String
  description      String
  amountCents      Int            @map("amount_cents")
  paymentAccountId BigInt         @map("payment_account_id")
  expenseAccountId BigInt         @map("expense_account_id")
  frequencyEvery   Int            @default(1) @map("frequency_every")
  frequencyUnit    RecurrenceUnit @map("frequency_unit")
  startOn          DateTime       @map("start_on") @db.Date
  nextDueOn        DateTime       @map("next_due_on") @db.Date
  endOn            DateTime?      @map("end_on") @db.Date
  reference        String?
  notes            String?
  active           Boolean        @default(true)
  createdBy        String         @map("created_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  paymentAccount   Account        @relation("SubscriptionSource", fields: [paymentAccountId], references: [id])
  expenseAccount   Account        @relation("SubscriptionExpense", fields: [expenseAccountId], references: [id])
  creator          BookkeeperUser @relation(fields: [createdBy], references: [id])

  @@map("subscriptions")
}

model Contact {
  id        BigInt         @id @default(autoincrement())
  type      ContactType
  name      String
  email     String?
  phone     String?
  company   String?
  notes     String?
  active    Boolean        @default(true)
  createdBy String         @map("created_by") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  creator   BookkeeperUser @relation(fields: [createdBy], references: [id])
  invoices  Invoice[]

  @@index([type, active])
  @@map("contacts")
}

model Invoice {
  id               BigInt         @id @default(autoincrement())
  invoiceNumber    String         @unique @map("invoice_number")
  customerId       BigInt         @map("customer_id")
  issueOn          DateTime       @map("issue_on") @db.Date
  dueOn            DateTime       @map("due_on") @db.Date
  status           InvoiceStatus  @default(draft)
  amountCents      Int            @map("amount_cents")
  revenueAccountId BigInt         @map("revenue_account_id")
  paymentAccountId BigInt         @map("payment_account_id")
  transactionId    BigInt?        @map("transaction_id")
  description      String
  notes            String?
  createdBy        String         @map("created_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  customer         Contact        @relation(fields: [customerId], references: [id])
  revenueAccount   Account        @relation("InvoiceRevenue", fields: [revenueAccountId], references: [id])
  paymentAccount   Account        @relation("InvoicePayment", fields: [paymentAccountId], references: [id])
  transaction      Transaction?   @relation(fields: [transactionId], references: [id])
  creator          BookkeeperUser @relation(fields: [createdBy], references: [id])

  @@index([customerId, status])
  @@index([dueOn, status])
  @@map("invoices")
}

model Document {
  id         BigInt         @id @default(autoincrement())
  label      String
  url        String
  entityType String         @map("entity_type")
  entityId   String         @map("entity_id")
  notes      String?
  createdBy  String         @map("created_by") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  creator    BookkeeperUser @relation(fields: [createdBy], references: [id])

  @@index([entityType, entityId])
  @@map("documents")
}

model Reminder {
  id          BigInt           @id @default(autoincrement())
  title       String
  details     String?
  dueOn       DateTime         @map("due_on") @db.Date
  dueTime     String?          @map("due_time")
  priority    ReminderPriority @default(normal)
  status      ReminderStatus   @default(open)
  createdBy   String           @map("created_by") @db.Uuid
  completedAt DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  creator     BookkeeperUser   @relation(fields: [createdBy], references: [id])

  @@map("reminders")
}

model AuditLog {
  id         BigInt         @id @default(autoincrement())
  actorId    String         @map("actor_id") @db.Uuid
  action     String
  entityType String         @map("entity_type")
  entityId   String         @map("entity_id")
  summary    String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      BookkeeperUser @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

enum Role {
  owner
  manager
  member
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum TransactionType {
  income
  expense
}

enum TimesheetStatus {
  submitted
  approved
  paid
}

enum RecurrenceUnit {
  day
  week
  month
  year
}

enum ContactType {
  customer
  vendor
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  void
}

enum ReminderPriority {
  low
  normal
  high
  urgent
}

enum ReminderStatus {
  open
  done
}
